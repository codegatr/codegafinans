# CODEGA Finans - public_html uyum katmani
#
# Bu paket, paylasimli hostinglerde ZIP dogrudan domainin mevcut
# public_html klasorune acildiginda calisacak sekilde hazirlandi.
# Web istekleri icerde public_html/ altina aktarilir; inc/, cli/,
# migrations/ gibi uygulama dosyalari disaridan erisime kapali kalir.

ServerSignature Off
DirectoryIndex public_html/index.php

AddDefaultCharset UTF-8

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hassas klasorler ve kok dosyalar webden okunamaz.
    RewriteRule ^(?:inc|cli|migrations|storage|backups|updates|docs)(?:/|$) - [R=404,L,NC]
    RewriteRule ^(?:manifest\.json|README\.md|CHANGELOG\.md|PUBLIC_HTML-KURULUM\.md|\.gitignore|\.env)$ - [R=404,L,NC]

    # Temiz URL: /login.php -> /public_html/login.php.
    # Fiziksel dosya/klasorleri bozma; sadece web isteklerini ic public_html'e aktar.
    RewriteCond %{REQUEST_URI} !^/public_html/ [NC]
    RewriteCond %{DOCUMENT_ROOT}/public_html/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public_html/$1 -d
    RewriteRule ^(.*)$ public_html/$1 [L,QSA]

    # Koke gelen istek icin acilis sayfasi.
    RewriteRule ^$ public_html/index.php [L,QSA]
</IfModule>
